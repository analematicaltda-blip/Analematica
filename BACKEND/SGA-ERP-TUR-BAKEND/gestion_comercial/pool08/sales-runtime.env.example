# GC-007: disabled by missing configuration; never paste keys into source control.
# Separate HMAC key for reviewed SGA -> native ledger source/acknowledgment.
# Configure >=32 random characters through the runtime secret channel on both peers.
COMMERCIAL_SALES_SOURCE_KEY=
# SGA only: fixed HTTPS origin and explicit native ledger system; no runtime URL input.
COMMERCIAL_SALES_LEDGER_ORIGIN=
COMMERCIAL_SALES_LEDGER_SYSTEM=erp-tur
# Optional extra CA file, in addition to system trust. Never disable TLS verification.
COMMERCIAL_SALES_LEDGER_CA_FILE=
# Reserved for literal loopback test fixtures, never enable in production.
COMMERCIAL_SALES_ALLOW_LOOPBACK_TESTS=0
# Native only: reviewed company/account-role policy JSON; no inferred cash/revenue mapping.
COMMERCIAL_SALE_ACCOUNT_POLICIES={}
# Native additive migration 0007_commercial_sales; SGA install_crm --apply adds
# own sale/event/claim tables and database guards. No historical sales migration.
# Source binding is separately reviewed through source_binding.review_binding;
# operator must be the current independent VerifiedCompanyLink reviewer.
# Renewal/revocation: revise_binding with expected_digest, fresh signed source
# context and explicit independent review. No self-service HTTP grants exist.
# Financial review + confirmation remain separate requests by the same manager.
# Outbox stays pending until a reviewed consumer exists; no DIAN issuance or bank transfer.
