# Read-only commercial account metrics. Disabled until the owner configures access.
# Keep secrets in the host secret store, never in a committed profile or a report.
COMMERCIAL_ANALYTICS_PROVIDER_READ_ENABLED=0
# JSON keyed SYSTEM:COMPANY:PROVIDER (SGA-CD uses "-"); each alias owns one profile.
# Exact profile fields: platform (META|TIKTOK|GOOGLE_YOUTUBE), account_id,
# owner_id, credential_env (COMMERCIAL_ANALYTICS_SECRET_*),
# developer_token_env (Google only; empty otherwise), api_version (Google vNN).
COMMERCIAL_ANALYTICS_ACCOUNTS={}
# Account currency must be COP. Only official fixed hosts and read endpoints.
# API versions, account permissions and authentic results require provider qualification.
# No publication, ads change, payment or automatic enrollment is enabled here.
# Optional finite-horizon LTV scenarios, keyed identically. No defaults fabricated.
# Exact fields: version, owner_ref, reviewer_ref, support_digest, valid_from,
# valid_until, gross_margin_fraction, monthly_churn_fraction, horizon_months,
# justification. Fractions are exact strings; horizon is 1..120 months.
COMMERCIAL_ANALYTICS_LTV_POLICIES={}
# A declared review/support digest is not independent professional qualification.
