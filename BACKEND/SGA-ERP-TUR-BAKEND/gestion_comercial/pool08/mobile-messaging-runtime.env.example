# All network/workers disabled. Never place provider credentials in frontend.
COMMERCIAL_MOBILE_WORKER_ENABLED=0
COMMERCIAL_MOBILE_NETWORK_ENABLED=0
# Keys: SYSTEM:SCOPE:PROVIDER_OR_- -> SMS/MMS/WHATSAPP -> reviewed scoped policy.
COMMERCIAL_MOBILE_POLICIES={}
# Independent normalized receipt-adapter keys, >=32 characters, managed securely.
COMMERCIAL_MOBILE_RECEIPT_KEYS={}
# Policies bind credential_env to COMMERCIAL_MOBILE_SECRET_<NAME>.
# Twilio secret value is JSON account_sid/auth_token; WhatsApp value is the token.
# A co_support_digest is an operator declaration, not proof of MMS support in Colombia.

# mobile-policy.example.json is a disabled illustrative schema, not an approved sender.
# Replace placeholders only after provider/account/CO support and content review.
# Media kinds/duration/bytes and WhatsApp header/body must match the approved template.
