# Disabled by default. No provider secrets or customer data in frontend.
COMMERCIAL_EMAIL_WORKER_ENABLED=0
# Mapping SYSTEM:SCOPE:PROVIDER_OR_- to scoped sender policy.
# Policy keys: version, sender_email, sender_name, postal_address, public_base_url,
# daily_limit (1..100), consent_reviewed, allow_dispatch, smtp_host, smtp_port.
# Only loopback SMTP:1025 supported currently. Never enable a relay without authorization.
COMMERCIAL_EMAIL_POLICIES={}
# Independently provisioned >=32 character keys; keep outside the repository.
COMMERCIAL_EMAIL_LINK_KEYS={}

# Separate normalized receipt-adapter keys; no opened-pixel tracking.
COMMERCIAL_EMAIL_RECEIPT_KEYS={}
