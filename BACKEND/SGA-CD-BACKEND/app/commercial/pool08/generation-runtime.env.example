# Disabled until the operator binds an installed model to its company/provider.
# Obtain the model digest from the intended Ollama /api/tags endpoint, not a blob hash.
# SYSTEM is sga-cd, erp-tur or analematica. No credentials in client code.
COMMERCIAL_GENERATION_WORKER_ENABLED=0
COMMERCIAL_GENERATION_PROFILES={}
# Profile format: {"SYSTEM:SCOPE:PROVIDER_OR_-":{"copy":{"adapter":"ollama","model":"gemma3:4b","model_digest":"64_HEX_FROM_API_TAGS","rights_note":"Reviewed model license and intended use","cost_units":100,"max_output_tokens":512}}}
# Fixed local/container endpoints only; no untrusted URLs.
COMMERCIAL_GENERATION_ENDPOINTS={}
# Remote engine approvals are exact profile configuration digests, scoped to the company.
COMMERCIAL_GENERATION_REMOTE_APPROVALS={}
# Scoped mappings reference environment variable names; never contain credentials.
COMMERCIAL_GENERATION_SECRET_BINDINGS={}

# GC-014: bind adapter ffmpeg-composition, model ffmpeg-composition-v1, to a scoped profile.
# Obtain renderer model_digest with python -m <own_pool08_module>.video_composition.
# It binds source, FFmpeg version, font and Pillow version. No voice cloning or cloud invocation.
# Voice/music: reviewed private MP4 library sources; consent and hashes rechecked on completion.
